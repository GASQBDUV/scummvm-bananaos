# ScummVM on the RG DS Plus (BananaOS)
# clicks: A / L1 = left, B / L2 = right
a = mouse_left
b = mouse_right
l1 = mouse_left
l2 = mouse_right
# R1 held = slow pointer for precise aiming
r1 = mouse_slow
# R2 = cycle: mirrored screens, verb screen (games that have one), zoom
r2 = f10
# L3 (press the left stick) = zoom level in the zoom mode: 1.5x, 2x, 3x
l3 = f8
# X = Esc (skip cutscene, close dialog), Y = skip a line of dialogue, Start = game menu, Select = on-screen keyboard (copy protection, names)
x = esc
y = f9
start = f5
back = f7
# pointer: left stick and D-pad
left_analog_up = mouse_movement_up
left_analog_down = mouse_movement_down
left_analog_left = mouse_movement_left
left_analog_right = mouse_movement_right
up = mouse_movement_up
down = mouse_movement_down
left = mouse_movement_left
right = mouse_movement_right
mouse_scale = 4096
mouse_delay = 16
