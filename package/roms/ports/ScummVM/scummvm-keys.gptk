# ScummVM on the RG DS Plus (BananaOS): keyboard games (Sierra AGI, Hugo, Hi-Res Adventure)
# The launcher switches to this map when such a game starts. These games walk with the arrow keys and take typed commands.
# D-pad = arrow keys. The left stick still moves the pointer (AGI also walks to where you click).
up = up
down = down
left = left
right = right
left_analog_up = mouse_movement_up
left_analog_down = mouse_movement_down
left_analog_left = mouse_movement_left
left_analog_right = mouse_movement_right
# A = Enter (run the typed command, "press any key"), B = right click, L1 = click, L2 = right click
a = enter
b = mouse_right
l1 = mouse_left
l2 = mouse_right
r1 = mouse_slow
r2 = f10
l3 = f8
# X = Esc (the AGI menu), Y = F3 (repeat the last command), Start = F5 (save in AGI), Select = on-screen keyboard
x = esc
y = f3
start = f5
back = f7
mouse_scale = 4096
mouse_delay = 16
